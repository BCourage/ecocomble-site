# ============================================================
# ÉCOCOMBLE — Configuration Apache / Infomaniak
# Révision du 18/07/2026
# ============================================================

Options -Indexes

RewriteEngine On

# ── 1. HTTPS + www en UNE seule redirection ──────────────────
# (avant : http://ecocomble.fr faisait 2 sauts, maintenant 1)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

# ── 2. /index et /index.html → / ─────────────────────────────
# Évite que la page d'accueil soit accessible sous 2 URLs.
# Doit rester AVANT la règle 4 (suppression du .html).
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# ── 3. Supprimer le slash final ──────────────────────────────
# CORRECTIF : /zones/ renvoyait vers une URL cassée (404).
# Le test !-d protège les vrais répertoires (dont /cartes/).
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ── 4. URLs propres — supprimer .html des URLs ───────────────
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Si l'URL n'a pas d'extension → servir le fichier .html correspondant
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}.html -f
RewriteRule ^ %{REQUEST_URI}.html [L]

# ── 5. (SUPPRIMÉ) Anciennes règles SPA ───────────────────────
# Les règles ^realisations/?$ ^zones/?$ ^contact/?$ qui redirigeaient
# vers /#ancre ont été retirées : ces pages existent désormais en
# statique. Elles provoquaient un 404 sur les URLs à slash final.

# ── 6. Page 404 personnalisée ────────────────────────────────
ErrorDocument 404 /index.html

# ── 7. Cache navigateur ──────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 1 hour"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript        "access plus 1 month"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 month"
  ExpiresByType image/x-icon           "access plus 1 year"
</IfModule>

# ── 8. Compression Gzip ──────────────────────────────────────
# (les images WebP/JPEG/PNG sont déjà compressées : ne pas les inclure)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/xml text/xml application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── 9. Sécurité headers ──────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Cache long sur les images (nommées de façon stable)
  <FilesMatch "\.(webp|jpg|jpeg|png|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
